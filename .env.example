# Copie para .env (na raiz ou em apps/server/) e ajuste.
# Segredo usado para assinar os tokens JWT. OBRIGATÓRIO fora do ambiente de desenvolvimento.
JWT_SECRET=troque-por-uma-string-longa-e-aleatoria
# Porta do servidor (padrão 3333; o proxy do Vite em dev aponta para ela)
UCOP_PORT=3333
# Em produção atrás de HTTPS (Cloudflare Tunnel), o cookie das imagens é "secure"
# quando NODE_ENV=production. Use COOKIE_SECURE=false se servir só por HTTP.
# COOKIE_SECURE=false
# Pasta de dados (SQLite + uploads). Padrão: apps/server/data
# DATA_DIR=
